{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Brent Oil Price Time Series Analysis\n",
    "\n",
    "This notebook performs comprehensive time series analysis on Brent oil price data, including:\n",
    "- Data loading and validation\n",
    "- Stationarity testing (ADF, KPSS)\n",
    "- Returns computation and analysis\n",
    "- Volatility analysis\n",
    "- Visualization of trends and patterns\n",
    "\n",
    "**Author:** Data Analysis Team\n",
    "**Date:** 2024\n",
    "**Data:** Brent Oil Prices (1987-Present)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Setup and Imports"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import sys\n",
    "import os\n",
    "sys.path.append(os.path.abspath('..'))\n",
    "\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "import logging\n",
    "\n",
    "# Configure plotting\n",
    "plt.style.use('seaborn-v0_8-darkgrid')\n",
    "sns.set_palette(\"husl\")\n",
    "%matplotlib inline\n",
    "\n",
    "# Configure logging\n",
    "logging.basicConfig(level=logging.INFO, format='%(levelname)s: %(message)s')\n",
    "\n",
    "print(\"Imports completed successfully!\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Import Custom Modules"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from src.data_loader import (\n",
    "    load_brent_data, \n",
    "    validate_data, \n",
    "    clean_data, \n",
    "    compute_log_returns,\n",
    "    load_events_data\n",
    ")\n",
    "\n",
    "from src.time_series_analysis import (\n",
    "    run_stationarity_tests,\n",
    "    compute_volatility,\n",
    "    detect_volatility_regimes,\n",
    "    compute_rolling_statistics,\n",
    "    test_arch_effects\n",
    ")\n",
    "\n",
    "from src.visualization import (\n",
    "    plot_price_trend,\n",
    "    plot_returns_distribution,\n",
    "    plot_volatility_analysis,\n",
    "    plot_stationarity_diagnostics,\n",
    "    plot_events_overlay\n",
    ")\n",
    "\n",
    "print(\"Custom modules imported successfully!\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Data Loading and Initial Exploration"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Load Brent oil price data\n",
    "DATA_PATH = \"../data/raw/BrentOilPrices.csv\"\n",
    "\n",
    "try:\n",
    "    df_raw = load_brent_data(DATA_PATH)\n",
    "    print(f\"\\nData loaded successfully!\")\n",
    "    print(f\"Shape: {df_raw.shape}\")\n",
    "    print(f\"\\nDate range: {df_raw.index.min()} to {df_raw.index.max()}\")\n",
    "    print(f\"\\nFirst few rows:\")\n",
    "    display(df_raw.head())\n",
    "except Exception as e:\n",
    "    print(f\"Error loading data: {e}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Data validation\n",
    "print(\"\\n=== DATA VALIDATION ===\")\n",
    "validation_results = validate_data(df_raw)\n",
    "\n",
    "print(f\"Valid: {validation_results['is_valid']}\")\n",
    "print(f\"Missing values: {validation_results['missing_count']} ({validation_results['missing_pct']:.2f}%)\")\n",
    "print(f\"Outliers: {validation_results['outliers']}\")\n",
    "print(f\"Non-positive prices: {validation_results['negative_prices']}\")\n",
    "\n",
    "if validation_results['warnings']:\n",
    "    print(\"\\nWarnings:\")\n",
    "    for w in validation_results['warnings']:\n",
    "        print(f\"  - {w}\")\n",
    "\n",
    "if validation_results['errors']:\n",
    "    print(\"\\nErrors:\")\n",
    "    for e in validation_results['errors']:\n",
    "        print(f\"  - {e}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Clean data\n",
    "df_clean = clean_data(df_raw, fill_method='linear')\n",
    "print(f\"\\nData cleaned. Shape: {df_clean.shape}\")\n",
    "\n",
    "# Basic statistics\n",
    "print(\"\\n=== PRICE STATISTICS ===\")\n",
    "print(df_clean['Price'].describe())"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Stationarity Testing"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 4.1 Price Levels Stationarity\n",
    "\n",
    "We test the raw price series for stationarity using both ADF and KPSS tests."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "print(\"\\n=== STATIONARITY TEST: PRICE LEVELS ===\\n\")\n",
    "\n",
    "price_stationarity = run_stationarity_tests(df_clean['Price'], \"Price Levels\")\n",
    "\n",
    "# Display ADF results\n",
    "adf = price_stationarity['adf']\n",
    "print(\"ADF TEST (Augmented Dickey-Fuller)\")\n",
    "print(\"-\" * 50)\n",
    "print(f\"H0: Unit root present (non-stationary)\")\n",
    "print(f\"Test Statistic: {adf['test_statistic']:.4f}\")\n",
    "print(f\"p-value: {adf['p_value']:.4f}\")\n",
    "print(f\"Used Lag: {adf['used_lag']}\")\n",
    "print(f\"Observations: {adf['n_observations']}\")\n",
    "print(\"\\nCritical Values:\")\n",
    "for key, value in adf['critical_values'].items():\n",
    "    print(f\"  {key}: {value:.4f}\")\n",
    "print(f\"\\nResult: {adf['interpretation']}\")\n",
    "print(f\"Conclusion: {adf['conclusion']}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Display KPSS results\n",
    "kpss = price_stationarity['kpss']\n",
    "print(\"\\nKPSS TEST (Kwiatkowski-Phillips-Schmidt-Shin)\")\n",
    "print(\"-\" * 50)\n",
    "print(f\"H0: Stationary\")\n",
    "print(f\"Test Statistic: {kpss['test_statistic']:.4f}\")\n",
    "print(f\"p-value: {kpss['p_value']:.4f}\")\n",
    "print(f\"Lags: {kpss['lags']}\")\n",
    "print(\"\\nCritical Values:\")\n",
    "for key, value in kpss['critical_values'].items():\n",
    "    print(f\"  {key}: {value:.4f}\")\n",
    "print(f\"\\nResult: {kpss['interpretation']}\")\n",
    "print(f\"Conclusion: {kpss['conclusion']}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Consensus\n",
    "consensus = price_stationarity['consensus']\n",
    "print(\"\\n=== CONSENSUS INTERPRETATION ===\")\n",
    "print(f\"Classification: {consensus['classification']}\")\n",
    "print(f\"ADF says: {consensus['adf_result']}\")\n",
    "print(f\"KPSS says: {consensus['kpss_result']}\")\n",
    "print(f\"\\nRecommendation: {consensus['recommendation']}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 4.2 Compute Returns and Test Stationarity\n",
    "\n",
    "Log returns are typically stationary and are the appropriate input for many time series models."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Compute log returns\n",
    "df_returns = compute_log_returns(df_clean)\n",
    "print(f\"\\nLog returns computed. Non-null values: {df_returns['Log_Returns'].notna().sum()}\")\n",
    "\n",
    "# Display return statistics\n",
    "print(\"\\n=== LOG RETURNS STATISTICS ===\")\n",
    "returns_clean = df_returns['Log_Returns'].dropna()\n",
    "print(f\"Count: {len(returns_clean)}\")\n",
    "print(f\"Mean: {returns_clean.mean()*100:.4f}%\")\n",
    "print(f\"Std Dev: {returns_clean.std()*100:.4f}%\")\n",
    "print(f\"Min: {returns_clean.min()*100:.4f}%\")\n",
    "print(f\"Max: {returns_clean.max()*100:.4f}%\")\n",
    "print(f\"Skewness: {returns_clean.skew():.4f}\")\n",
    "print(f\"Kurtosis: {returns_clean.kurtosis():.4f}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "print(\"\\n=== STATIONARITY TEST: LOG RETURNS ===\\n\")\n",
    "\n",
    "returns_stationarity = run_stationarity_tests(returns_clean, \"Log Returns\")\n",
    "\n",
    "adf_r = returns_stationarity['adf']\n",
    "kpss_r = returns_stationarity['kpss']\n",
    "\n",
    "print(f\"ADF: statistic={adf_r['test_statistic']:.4f}, p={adf_r['p_value']:.4f} → {adf_r['interpretation']}\")\n",
    "print(f\"KPSS: statistic={kpss_r['test_statistic']:.4f}, p={kpss_r['p_value']:.4f} → {kpss_r['interpretation']}\")\n",
    "print(f\"\\nConsensus: {returns_stationarity['consensus']['classification']}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. Volatility Analysis"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 5.1 Compute Rolling Volatility"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Compute volatility with different windows\n",
    "df_vol = compute_volatility(df_returns, windows=[30, 60, 90])\n",
    "\n",
    "print(\"Volatility columns added:\")\n",
    "vol_cols = [col for col in df_vol.columns if 'Volatility' in col]\n",
    "for col in vol_cols:\n",
    "    print(f\"  - {col}\")\n",
    "\n",
    "# Display volatility statistics\n",
    "print(\"\\n=== VOLATILITY STATISTICS ===\")\n",
    "print(df_vol[vol_cols].describe())"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 5.2 Detect Volatility Regimes"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Detect volatility regimes using quantile method\n",
    "df_regimes = detect_volatility_regimes(df_vol, method='quantile')\n",
    "\n",
    "print(\"\\n=== VOLATILITY REGIME DISTRIBUTION ===\")\n",
    "regime_counts = df_regimes['Volatility_Regime'].value_counts()\n",
    "for regime, count in regime_counts.items():\n",
    "    pct = count / len(df_regimes) * 100\n",
    "    print(f\"{regime}: {count} days ({pct:.1f}%)\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 5.3 Test for ARCH Effects\n",
    "\n",
    "ARCH (Autoregressive Conditional Heteroscedasticity) effects indicate volatility clustering - periods of high volatility followed by high volatility."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Test for ARCH effects\n",
    "arch_results = test_arch_effects(df_returns['Log_Returns'].dropna(), max_lag=5)\n",
    "\n",
    "print(\"\\n=== ARCH EFFECTS TEST ===\")\n",
    "print(f\"H0: No ARCH effects\")\n",
    "print(f\"\\nLM Statistic: {arch_results['lm_statistic']:.4f}\")\n",
    "print(f\"p-value: {arch_results['lm_pvalue']:.4f}\")\n",
    "print(f\"Max Lag: {arch_results['max_lag']}\")\n",
    "print(f\"\\nResult: {arch_results['interpretation']}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 6. Rolling Statistics"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Compute rolling statistics\n",
    "df_rolling = compute_rolling_statistics(df_regimes)\n",
    "\n",
    "print(\"Rolling statistics added:\")\n",
    "rolling_cols = [col for col in df_rolling.columns if any(x in col for x in ['MA_', 'Std_', 'BB_'])]\n",
    "for col in rolling_cols[:10]:  # Show first 10\n",
    "    print(f\"  - {col}\")\n",
    "if len(rolling_cols) > 10:\n",
    "    print(f\"  ... and {len(rolling_cols)-10} more\")\n",
    "\n",
    "print(f\"\\nFinal dataset shape: {df_rolling.shape}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 7. Load Events Data"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Load events data\n",
    "EVENTS_PATH = \"../references/geopolitical_events.csv\"\n",
    "\n",
    "try:\n",
    "    df_events = load_events_data(EVENTS_PATH)\n",
    "    print(f\"Events loaded: {len(df_events)}\")\n",
    "    print(f\"\\nDate range: {df_events.index.min()} to {df_events.index.max()}\")\n",
    "    print(f\"\\nFirst 5 events:\")\n",
    "    display(df_events.head())\n",
    "except Exception as e:\n",
    "    print(f\"Error loading events: {e}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Event type distribution\n",
    "print(\"\\n=== EVENT TYPE DISTRIBUTION ===\")\n",
    "event_type_counts = df_events['Event_Type'].value_counts()\n",
    "print(event_type_counts)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 8. Visualizations"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 8.1 Price Trend with Moving Averages"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "fig = plot_price_trend(df_rolling, title=\"Brent Oil Price Trend with Moving Averages\")\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 8.2 Returns Distribution Analysis"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "fig = plot_returns_distribution(df_returns)\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 8.3 Volatility Analysis"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "fig = plot_volatility_analysis(df_regimes)\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 8.4 Stationarity Diagnostics"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "fig = plot_stationarity_diagnostics(df_returns)\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 8.5 Events Overlay"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "fig = plot_events_overlay(df_clean, df_events)\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 9. Summary of Results"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "print(\"=" * 70)\n",
    "print(\"BRENT OIL PRICE ANALYSIS - SUMMARY\")\n",
    "print(\"=\" * 70)\n",
    "\n",
    "print(\"\\n1. DATA COVERAGE:\")\n",
    "print(f\"   Period: {df_clean.index.min().strftime('%Y-%m-%d')} to {df_clean.index.max().strftime('%Y-%m-%d')}\")\n",
    "print(f\"   Total observations: {len(df_clean)}\")\n",
    "print(f\"   Analyzed events: {len(df_events)}\")\n",
    "\n",
    "print(\"\\n2. STATIONARITY RESULTS:\")\n",
    "print(f\"   Price Levels: {price_stationarity['consensus']['classification']}\")\n",
    "print(f\"     - ADF p-value: {price_stationarity['adf']['p_value']:.4f}\")\n",
    "print(f\"     - KPSS p-value: {price_stationarity['kpss']['p_value']:.4f}\")\n",
    "print(f\"   Log Returns: {returns_stationarity['consensus']['classification']}\")\n",
    "print(f\"     - ADF p-value: {returns_stationarity['adf']['p_value']:.4f}\")\n",
    "print(f\"     - KPSS p-value: {returns_stationarity['kpss']['p_value']:.4f}\")\n",
    "\n",
    "print(\"\\n3. VOLATILITY ANALYSIS:\")\n",
    "print(f\"   Annualized volatility: {returns_clean.std() * np.sqrt(252) * 100:.2f}%\")\n",
    "for regime, count in regime_counts.items():\n",
    "    pct = count / len(df_regimes) * 100\n",
    "    print(f\"   {regime} volatility: {pct:.1f}% of time\")\n",
    "\n",
    "print(\"\\n4. ARCH EFFECTS:\")\n",
    "print(f\"   {arch_results['interpretation']}\")\n",
    "print(f\"   LM statistic: {arch_results['lm_statistic']:.4f} (p={arch_results['lm_pvalue']:.4f})\")\n",
    "\n",
    "print(\"\\n5. KEY IMPLICATIONS:\")\n",
    "print(f\"   - Prices are {price_stationarity['consensus']['classification'].lower()}, requiring differencing for ARMA modeling\")\n",
    "print(f\"   - Returns are {returns_stationarity['consensus']['classification'].lower()}, suitable for direct modeling\")\n",
    "if arch_results['has_arch_effects']:\n",
    "    print(f\"   - Volatility clustering detected: GARCH-type models may be appropriate\")\n",
    "else:\n",
    "    print(f\"   - No significant volatility clustering detected\")\n",
    "\n",
    "print(\"\\n\" + \"=\" * 70)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 10. Save Results"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Create outputs directory\n",
    "import os\n",
    "os.makedirs(\"../outputs\", exist_ok=True)\n",
    "\n",
    "# Save processed data\n",
    "df_rolling.to_csv(\"../outputs/processed_data.csv\")\n",
    "print(\"Saved processed data to ../outputs/processed_data.csv\")\n",
    "\n",
    "# Save test results\n",
    "results_summary = {\n",
    "    'price_stationarity': price_stationarity,\n",
    "    'returns_stationarity': returns_stationarity,\n",
    "    'arch_test': arch_results,\n",
    "    'volatility_regimes': regime_counts.to_dict(),\n",
    "    'date_range': {\n",
    "        'start': df_clean.index.min().strftime('%Y-%m-%d'),\n",
    "        'end': df_clean.index.max().strftime('%Y-%m-%d')\n",
    "    }\n",
    "}\n",
    "\n",
    "import json\n",
    "with open(\"../outputs/analysis_results.json\", \"w\") as f:\n",
    "    json.dump(results_summary, f, indent=2, default=str)\n",
    "\n",
    "print(\"Saved analysis results to ../outputs/analysis_results.json\")"
   ]
  }
